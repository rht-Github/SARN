CREATE TABLE OLAP_SYS.CONTEO_PATRONES(
PATRON_TYPE			VARCHAR2(50) NOT NULL,
SORTEO_ID			NUMBER NOT NULL,
B_TYPE				VARCHAR2(2) NOT NULL,
J_DIGIT_TYPE		VARCHAR2(20),
J_DIGIT_COUNT_STR	VARCHAR2(20),
J_PREFERENCIA_FLAG  VARCHAR2(1), 
R_DIGIT_TYPE		VARCHAR2(20),
R_PREFERENCIA_FLAG  VARCHAR2(1), 
ATRIBUTO_STR1		VARCHAR2(20),
ATRIBUTO_STR2		VARCHAR2(20),
ATRIBUTO_STR3		VARCHAR2(20),
ATRIBUTO_STR4		VARCHAR2(20),
ATRIBUTO_STR5		VARCHAR2(20),
ATRIBUTO_FLOAT1		FLOAT DEFAULT 0.0,
ATRIBUTO_FLOAT2		FLOAT DEFAULT 0.0,
ATRIBUTO_FLOAT3		FLOAT DEFAULT 0.0,
ATRIBUTO_FLOAT4		FLOAT DEFAULT 0.0,
ATRIBUTO_FLOAT5		FLOAT DEFAULT 0.0,
ATRIBUTO_NUM1		NUMBER DEFAULT 0,
ATRIBUTO_NUM2		NUMBER DEFAULT 0,
ATRIBUTO_NUM3		NUMBER DEFAULT 0,
ATRIBUTO_NUM4		NUMBER DEFAULT 0,
ATRIBUTO_NUM5		NUMBER DEFAULT 0,
MATCH1				NUMBER DEFAULT 0,
MATCH2				NUMBER DEFAULT 0,
MATCH3				NUMBER DEFAULT 0,
MATCH4				NUMBER DEFAULT 0,
MATCH5				NUMBER DEFAULT 0,
MATCH6				NUMBER DEFAULT 0,
NO_MATCH1			NUMBER DEFAULT 0,
NO_MATCH2			NUMBER DEFAULT 0,
NO_MATCH3			NUMBER DEFAULT 0,
NO_MATCH4			NUMBER DEFAULT 0,
NO_MATCH5			NUMBER DEFAULT 0,
NO_MATCH6			NUMBER DEFAULT 0,
CREATED_BY			VARCHAR2(30) DEFAULT USER NOT NULL,
CREATION_DATE		DATE DEFAULT SYSDATE  NOT NULL,
UPDATED_DATE		DATE DEFAULT SYSDATE  NOT NULL
) TABLESPACE OLAP_BIG_DATA_TBL
/

COMMENT ON COLUMN CONTEO_PATRONES.PATRON_TYPE IS 'Nombre del patron'
/
COMMENT ON COLUMN CONTEO_PATRONES.SORTEO_ID IS 'Id del sorteo'
/
COMMENT ON COLUMN CONTEO_PATRONES.B_TYPE IS 'Identificador de la posicion'
/
COMMENT ON COLUMN CONTEO_PATRONES.J_DIGIT_TYPE IS 'tipo de digito. 1: primo, 2: par, 3:impar'
/
COMMENT ON COLUMN CONTEO_PATRONES.J_DIGIT_COUNT_STR IS 'concatenacion de los conteos de la posicion'
/
COMMENT ON COLUMN CONTEO_PATRONES.J_PREFERENCIA_FLAG IS 'Indicador de numero preferente'
/
COMMENT ON COLUMN CONTEO_PATRONES.R_DIGIT_TYPE IS 'tipo de digito. 1: primo, 2: par, 3:impar'
/
COMMENT ON COLUMN CONTEO_PATRONES.R_PREFERENCIA_FLAG IS 'Indicador de numero preferente'
/
COMMENT ON COLUMN CONTEO_PATRONES.MATCH1 IS 'Match por posicion. 1 hay match, 0 no hay match'
/
COMMENT ON COLUMN CONTEO_PATRONES.NO_MATCH1 IS 'No match por posicion. 1 no hay match, 0 hay match'
/

